{
  "openapi": "3.0.1",
  "info": {
    "title": "示警智慧加值服務平台 API",
    "description": "示警智慧加值服務平台 API 說明",
    "contact": {
      "name": "民生示警公開資料平台",
      "url": "https://alerts.ncdr.nat.gov.tw",
      "email": "alert@ncdr.nat.gov.tw"
    },
    "version": "v1"
  },
  "servers": [
    {
      "url": "/AddValueApi"
    }
  ],
  "paths": {
    "/EventCode": {
      "get": {
        "tags": [
          "代碼清單"
        ],
        "summary": "示警清單及對應代碼",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/EventCode"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/OrgCode": {
      "get": {
        "tags": [
          "代碼清單"
        ],
        "summary": "發布單位清單及對應代碼",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/OrgCode"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/RealTime": {
      "get": {
        "tags": [
          "即時示警"
        ],
        "summary": "提供當前有效的示警訊息",
        "parameters": [
          {
            "name": "geocode",
            "in": "query",
            "description": "欲查詢的縣市或鄉鎮代碼",
            "required": true,
            "schema": {
              "type": "string",
              "example": "65"
            },
            "example": "65"
          },
          {
            "name": "offset",
            "in": "query",
            "description": "回傳資料的起始筆數",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32",
              "example": 0
            },
            "example": 0
          },
          {
            "name": "limit",
            "in": "query",
            "description": "輸出的資料筆數",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32",
              "example": 20
            },
            "example": 20
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Alert"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/RealTime/Event": {
      "get": {
        "tags": [
          "即時示警"
        ],
