            "schema": {
              "type": "string",
              "example": "65"
            },
            "example": "65"
          },
          {
            "name": "offset",
            "in": "query",
            "description": "回傳資料的起始筆數",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32",
              "example": 0
            },
            "example": 0
          },
          {
            "name": "limit",
            "in": "query",
            "description": "輸出的資料筆數",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32",
              "example": 20
            },
            "example": 20
          }
        ],
        "responses": {
          "200"