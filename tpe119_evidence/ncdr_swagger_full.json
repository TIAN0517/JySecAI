  "components": {
    "schemas": {
      "Alert": {
        "type": "object",
        "properties": {
          "identifier": {
            "type": "string",
            "description": "Identifier",
            "nullable": true,
            "example": "123456789"
          },
          "sender": {
            "type": "string",
            "nullable": true
          },
          "sentDate": {
            "type": "string",
            "nullable": true
          },
          "msgType": {
            "type": "string",
            "nullable": true
          },
          "references": {
            "type": "string",
            "nullable": true
          },
          "info": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Info"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "Area": {
        "type": "object",
        "properties": {
          "areaDesc": {
            "type": "string",
            "nullable": true
          },
          "polygon": {
            "type": "string",
            "nullable": true
          },
          "circle": {
            "type": "string",
            "nullable": true
          },
          "geocode": {
            "type": "string",
            "nullable": true
          },
          "altitude": {
            "type": "string",
            "nullable": true
          },
          "ceiling": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "錯誤代碼",
            "nullable": true,
            "example": "401"
          },
          "message": {
            "type": "string",
            "description": "錯誤訊息",
            "nullable": true,
            "example": "權限錯誤"
          }
        },
        "additionalProperties": false
      },
      "EventCode": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "示警代碼",
            "nullable": true,
            "example": "RA"
          },
          "name": {
            "type": "string",
            "description": "示警名稱",
            "nullable": true,
            "example": "降雨"
          }
        },
        "additionalProperties": false,
        "description": "示警代碼清單ViewModel"
      },
      "Info": {
        "type": "object",
        "properties": {
          "language": {
            "type": "string",
            "description": "Language",
            "nullable": true,
            "example": "zh-TW"
          },
          "category": {
            "type": "string",
            "nullable": true
          },
          "eventCode": {
            "$ref": "#/components/schemas/KVPData"
          },
          "event": {
            "type": "string",
            "description": "Event",
            "nullable": true,
            "example": "降雨"
          },
          "urgency": {
            "type": "string",
            "nullable": true
          },
          "severity": {
            "type": "string",
            "nullable": true
          },
          "effective": {
            "type": "string",
            "nullable": true
          },
          "onset": {
            "type": "string",
            "nullable": true
          },
          "expires": {
            "type": "string",
            "nullable": true
          },
          "senderName": {
            "type": "string",
            "nullable": true
          },
          "headline": {
            "type": "string",
            "nullable": true
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "parameter": {
            "$ref": "#/components/schemas/KVPData"
          },
          "area": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Area"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "KVPData": {
        "type": "object",
        "properties": {
          "valueName": {
            "type": "string",
            "description": "parameter name",
            "nullable": true
          },
          "value": {
            "type": "string",
            "description": "property value",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "OrgCode": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "單位代碼",
            "nullable": true,
            "example": "CWA"
          },
          "name": {
            "type": "string",
            "description": "單位名稱",
            "nullable": true,
            "example": "中央氣象署"
          }
        },
        "additionalProperties": false,
        "description": "單位代碼清單ViewModel"
      }
    },
    "securitySchemes": {
