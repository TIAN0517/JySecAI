    },
    "generic_vietnamese_logistics": {
      "name": "通用越南物流系统",
      "endpoints": {
        "tracking": ["/Tracking", "/TraCuu", "/TrackAndTrace"],
        "management": ["/Admin", "/Management", "/Dashboard"],
        "payment": ["/Payment", "/Checkout"]
      },
      "characteristics": {
        "technology": "Unknown",
