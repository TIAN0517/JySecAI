\n// }\r\n\r\nexport function addBatchTask(data) {\r\n  return request.post(`${baseURL}/batch`, data)\r\n}\r\n\r\nexport function deleteTask(id) {\r\n  // 判断是不是纯数字ID\r\n  const isNumeric = /^[0-9]+$/.test(id)\r\n  const endpoint = isNumeric ? `${baseURL}/${id}` : `${baseURL}/group/${id}`\r\n  return request.delete(endpoint)\r\n}\r\n\r\n// 更新任务状态\r\nexport function updateTaskStatus(id, status) {\r\n  return request.put(`${baseURL}/${id}/status`, JSON.stringify(status), {\r\n    headers: { 'Content-Type': 'application/json' }\r\n  })\r\n}\r\n\r\n// 启动任务\r\nexport function startTask(id,source) {\r\n  return request.get(`${baseURL}/${id}/startTask?source=${source}`)\r\n}\r\n\r\nexport function startGroupTask(id,source) {\r\n  return request.get(`${baseURL}/${id}/startTaskBygroup?source=${source}`)\r\n}\r\n\r\n\r\n\r\n\r\n// 停止任务\r\nexport function stopTask(id) {\r\n  const isNumeric = /^[0-9]+$/.test(id)\r\n  const endpoint = isNumeric ? `${baseURL}/${id}/stopTask` : `${baseURL}/stopTaskByGroup`\r\n  return request.get(endpoint,{ params: { id } })\r\n}\r\n\r\n\r\nexport function updateTask(data) {\r\n  return request.post(`${baseURL}/task/edit`, data)\r\n}\r\n\r\n\r\n"],"mappings":";;;;AAAA,OAAOA,OAAO,MAAM,WAAW;AAE/B,IAAMC,OAAO,GAAG,WAAW;;AAE3B;AACA,OAAO,SAASC,WAAWA,CAACC,IAAI,EAAEC,IAAI,EAACC,MAAM,EAAE;EAC7C,OAAOL,OAAO,CAACM,GAAG,IAAAC,MAAA,CAAIN,OAAO,GAAI;IAAEO,MAAM,EAAE;MAAEL,IAAI,EAAJA,IAAI;MAAEC,IAAI,EAAJA,IAAI;MAACC,MAAM,EAANA;IAAO;EAAE,CAAC,CAAC;AACrE;AAEA,OAAO,SAASI,MAAMA,CAACC,EAAE,EAAE;EACzB,OAAOV,OAAO,CAACM,GAAG,IAAAC,MAAA,CAAIN,OAAO,WAAQ;IAAEO,MAAM,EAAE;MAAEG,MAAM,EAAED;IAAG;EAAE,CAAC,CAAC;AAClE;;AAGA;AACA,OAAO,SAASE,OAAOA,CAACC,IAAI,EAAE;EAC5B,OAAOb,OAAO,CAACc,IAAI,IAAAP,MAAA,CAAIN,OAAO,GAAIY,IAAI,CAAC;AACzC;;AAEA;AACA;AACA;AACA;;AAEA,OAAO,SAASE,YAAYA,CAACF,IAAI,EAAE;EACjC,OAAOb,OAAO,CAACc,IAAI,IAAAP,MAAA,CAAIN,OAAO,aAAUY,IAAI,CAAC;AAC/C;AAEA,OAAO,SAASG,UAAUA,CAACN,EAAE,EAAE;EAC7B;EACA,IAAMO,SAAS,GAAG,UAAU,CAACC,IAAI,CAACR,EAAE,CAAC;EACrC,IAAMS,QAAQ,GAAGF,S