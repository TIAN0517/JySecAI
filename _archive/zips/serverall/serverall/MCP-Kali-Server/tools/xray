class XrayScanner:
    def __init__(self):
        self.version = "1.9.11"
        self.plugins = {
            'xss': XSSScanner(),
            'sql': SQLScanner(),
            'cmd-injection': CommandInjectionScanner(),
            'xxe': XXEScanner(),
            'ssrf': SSRFScanner(),
            'path-traversal': PathTraversalScanner(),
            'redirect': RedirectScanner(),
            'fastjson': FastJSONScanner()
        }

    def version_check(self):
        """显示版本信息"""
        print(f"Xray {self.version}")
        print("A web security scanner designed for modern web applications")
        print("Copyright (c) 2020-2024 Chaitin Technology Ltd.")

    def webscan(self, target, plugins=None, output_file=None, max_depth=5, timeout=30):
        """执行Web扫描"""
        print(f"[INFO] Starting scan for: {target}")

        if plugins is None:
            plugins = ['xss', 'sql', 'cmd-injection', 'xxe', 'ssrf', 'path-traversal']

        results = []

        # 执行插件扫描
        for plugin_name in plugins:
            if plugin_name in self.plugins:
                print(f"[INFO] Running {plugin_name} plugin...")
                plugin_results = self.plugins[plugin_name].scan(target, max_depth, timeout)
                results.extend(plugin_results)
                time.sleep(0.5)  # 模拟扫描时间

        # 输出结果
        if output_file:
            self.save_results(results, output_file)
        else:
            print(json.dumps(results, indent=2, ensure_ascii=False))

        return results

    def save_results(self, results, output_file):
        """保存扫描结果"""
        with open(output_file, 'w', encoding='utf-8') as f:
            json.dump(results, f, indent=2, ensure_ascii=False)
        print(f"[INFO] Results saved to: {output_file}")

class XSSScanner:
    def scan(self, target, max_depth, timeout):
        """XSS扫描"""
        results = []

        # 模拟XSS漏洞发现
        test_urls = [
            f"{target}/search?q=test",
            f"{target}/comment?text=test",
            f"{target}/profile?name=test"
        ]

        xss_payloads = [
            "<script>alert('XSS')</script>",
            "';alert('XSS');//",
            "<img src=x onerror=alert('XSS')>"
        ]

        for url in test_urls:
            for payload in xss_payloads:
                if random.random() > 0.8:  # 20%概率发现漏洞
                    results.append({
                        "plugin": "xss",
                        "detail": {
                            "severity": "high" if "script" in payload else "medium",
                            "description": f"Reflected XSS vulnerability found in parameter",
                            "url": url,
                            "payload": payload,
                            "request": {
                                "method": "GET",
                                "url": url.replace("test", payload),
                                "headers": {"User-Agent": "Xray/1.9.11"}
                            },
                            "response": {
                                "status_code": 200,
                                "body": f"Reflected payload: {payload}"
                            }
                        },
                        "target": {"url": url}
                    })
        return results

