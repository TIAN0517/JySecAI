# 内网安全助手环境配置
# Internal Network Security Assistant Environment Configuration

# 目标范围配置
TARGET_SCOPE=
ORG_NAME=
PROJECT_NAME=

# 网络配置
ALLOWLIST_CIDR=
CONTACT_EMAIL=

# 数据库配置
DB_HOST=localhost
DB_PORT=5432
DB_NAME=security_assistant
DB_USER=
DB_PASSWORD=

# API配置
API_KEY=
API_SECRET=
API_BASE_URL=http://localhost:8000

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=logs/security_assistant.log
LOG_MAX_SIZE=10MB
LOG_BACKUP_COUNT=5

# 扫描配置
MAX_CONCURRENT_SCANS=5
SCAN_TIMEOUT=300
SCAN_RETRY_COUNT=3

# 安全配置
ENABLE_AUTHENTICATION=true
SESSION_TIMEOUT=3600
ENCRYPTION_KEY=

# 输出配置
OUTPUT_DIR=output/
REPORT_FORMAT=html,json,markdown
TEMPLATE_DIR=templates/

# 工具集成配置
NUCLEI_TEMPLATES_PATH=~/nuclei-templates
SQLMAP_PATH=/usr/bin/sqlmap
NMAP_PATH=/usr/bin/nmap

# 代理配置
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1

# 调试配置
DEBUG=false
VERBOSE=false
DRY_RUN=false

#GEMINI

GEMINI_API_KEYS="" # REDACTED: 原 12 组 Gemini 密钥已移除，请改用环境变量逐个配置