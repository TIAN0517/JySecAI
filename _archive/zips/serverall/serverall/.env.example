# Dragon-V Triple Bot 环境变量配置文件
# 复制此文件为 .env 并填入实际值

# Telegram Bot Tokens
TELEGRAM_ENTERPRISE_TOKEN=YOUR_ENTERPRISE_BOT_TOKEN_HERE
TELEGRAM_PROFESSIONAL_TOKEN=YOUR_PROFESSIONAL_BOT_TOKEN_HERE
TELEGRAM_SECURITY_TOKEN=YOUR_SECURITY_BOT_TOKEN_HERE

# AI服务配置
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# 数据库配置
DATABASE_PATH=dragon_triple_bot_unified.db
TELEGRAM_DB_PATH=dragon_triple_telegram_bot.db
FUNCTIONAL_DB_PATH=dragon_triple_functional.db

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=dragon_v_system.log

# 系统配置
DEBUG=false
MAX_WORKERS=10
MAX_CONNECTIONS=50

# 安全配置
ENCRYPTION_KEY_FILE=encryption_key.key
RATE_LIMIT_REQUESTS_PER_HOUR=100

# 网络配置
REQUEST_TIMEOUT=30
MAX_RETRIES=3
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36

# 备份配置
BACKUP_ENABLED=true
BACKUP_INTERVAL=86400
BACKUP_KEEP_COUNT=7

# 监控配置
MONITORING_INTERVAL=10
TASK_TIMEOUT=3600
ALERT_THRESHOLD=80

# 区域化配置
DEFAULT_LANGUAGE=zh-CN
TIMEZONE=Asia/Ho_Chi_Minh
ENCODING=UTF-8

# 开发配置
TEST_TARGET_1=http://testphp.vulnweb.com
TEST_TARGET_2=http://demo.testfire.net