# syntax=docker/dockerfile:1.7

FROM golang:1.25-bookworm AS build
WORKDIR /src
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=1 GOOS=linux go build \
    -trimpath \
    -ldflags="-s -w" \
    -o /out/jysec-core \
    ./cmd/server

FROM golang:1.25-bookworm AS core
ENV PATH=/app/tmp/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    PYTHONUNBUFFERED=1 \
    HOME=/app/tmp/home \
    GOPATH=/app/tmp/go \
    GOMODCACHE=/app/tmp/go/pkg/mod \
    GOCACHE=/app/tmp/go-build-cache \
    GOTMPDIR=/app/tmp/go-tmp \
    GOTELEMETRY=off \
    VIRTUAL_ENV=/app/tmp/venv
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      bash \
      binutils \
      ca-certificates \
      curl \
      dnsutils \
      file \
      git \
      iproute2 \
      jq \
      netcat-openbsd \
      nmap \
      openssh-client \
      passwd \
      python3 \
      python3-venv \
      tini \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /app/tmp \
    && python3 -m venv /app/tmp/venv \
    && /usr/sbin/groupadd --gid 10002 jysec \
    && /usr/sbin/useradd --uid 10002 --gid 10002 --create-home --shell /usr/sbin/nologin jysec

WORKDIR /app
COPY requirements.txt ./requirements.txt
RUN /app/tmp/venv/bin/pip install --no-cache-dir --requirement requirements.txt

COPY --from=build /out/jysec-core /usr/local/bin/jysec-core
COPY web ./web
COPY tools ./tools
COPY agents ./agents
COPY roles ./roles
COPY skills ./skills
COPY knowledge_base ./knowledge_base
COPY mcp-servers ./mcp-servers
COPY go.mod go.sum ./
COPY internal/c2/payload_templates ./internal/c2/payload_templates
COPY config.example.yaml ./config/config.example.yaml

# The runtime configuration is editable from the console, so every mutable
# directory is a dedicated volume in compose. Absolute paths keep config
# resolution stable even though the config file itself lives under /app/config.
RUN sed -i \
      -e 's#path: data/conversations.db#path: /app/data/conversations.db#' \
      -e 's#knowledge_db_path: data/knowledge.db#knowledge_db_path: /app/data/knowledge.db#' \
      -e 's#tools_dir: tools#tools_dir: /app/tools#' \
      -e 's#base_path: knowledge_base#base_path: /app/knowledge_base#' \
      -e 's#skills_dir: skills#skills_dir: /app/skills#' \
      -e 's#agents_dir: agents#agents_dir: /app/agents#' \
      -e 's#roles_dir: roles#roles_dir: /app/roles#' \
      -e 's#workspace_root_dir: ""#workspace_root_dir: /app/workspace#' \
      -e 's#reduction_root_dir: ""#reduction_root_dir: /app/workspace/.jysec/reduction#' \
      /app/config/config.example.yaml \
    && mkdir -p \
      /app/data \
      /app/tmp/home \
      /app/tmp/go/pkg/mod \
      /app/tmp/go-build-cache \
      /app/tmp/go-tmp \
      /app/workspace \
      /app/chat_uploads \
    && chown -R jysec:jysec \
      /app/config \
      /app/data \
      /app/tmp \
      /app/workspace \
      /app/chat_uploads \
      /app/tools \
      /app/agents \
      /app/roles \
      /app/skills \
      /app/knowledge_base

USER jysec
EXPOSE 8080
HEALTHCHECK --interval=20s --timeout=5s --start-period=30s --retries=5 \
  CMD ["curl", "-fsS", "-o", "/dev/null", "http://127.0.0.1:8080/"]
ENTRYPOINT ["tini", "--"]
CMD ["jysec-core", "--http", "-config", "/app/config/config.yaml"]
