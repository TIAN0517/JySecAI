# Normalize line endings: repo storage is always LF; working copy follows the rules below.
* text=auto

# Windows scripts need CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Shell scripts must stay LF (they run on Linux/WSL containers)
*.sh text eol=lf
*.py text eol=lf
*.service text eol=lf

# Binary assets — never normalize
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.zip binary
*.gz binary
*.tar binary
*.pdf binary
*.exe binary
*.onnx binary
*.gguf binary
