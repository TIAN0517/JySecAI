# =============================================================================
# CyberStrikeAI 环境变量示例（复制为 .env 并按需填写）
#   注意：.env / 所有 .env.*（除 .env.example 外）已被 .gitignore 忽略，请勿提交真实密钥。
# =============================================================================

# --- Python 运行时（MCP 外部 server 启动器） ---------------------------------
# Linux 默认：$ROOT_DIR/venv/bin/python3；Windows 请显式指定，例如：
JYSECAI_PYTHON=python

# --- 空间资产检索 API（可选；config.yaml 同 key，环境变量优先级更高） ----------
FOFA_API_KEY=
ZOOMEYE_API_KEY=
QUAKE_API_KEY=
SHODAN_API_KEY=

# --- 外部情报（vuln-intel MCP）----------------------------------------------
GITHUB_TOKEN=

# --- Dragon-V 数据目录覆写（可选；默认 mcp-servers/dragon_v/data） -------------
DRAGON_V_DATA_DIR=

# --- 控制面（可选）------------------------------------------------------------
JYSEC_CONTROL_PLANE_URL=
JYSEC_CONTROL_PLANE_TENANT_ID=

# --- 终端配色（可选）----------------------------------------------------------
#NO_COLOR=1
#FORCE_COLOR=1