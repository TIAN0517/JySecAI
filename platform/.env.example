NODE_ENV=development
JYSEC_HOST=0.0.0.0
JYSEC_PORT=8787
JYSEC_LOG_LEVEL=info

# Use PostgreSQL in production. memory is only for local evaluation and tests.
JYSEC_STORE=memory
DATABASE_URL=postgres://jysec:change-me@postgres:5432/jysec
REDIS_URL=redis://redis:6379/0

# A minimum 32-byte random secret. Do not commit its real value.
JYSEC_JWT_SECRET=replace-with-at-least-32-random-bytes
# Optional enterprise IdP. Leave empty to use HS256 with JYSEC_JWT_SECRET.
JYSEC_JWKS_URL=
JYSEC_JWT_ISSUER=jysecai
JYSEC_JWT_AUDIENCE=jysec-platform
JYSEC_DEV_AUTH=true

# Worker-to-control-plane job authenticity.
JYSEC_JOB_SIGNING_SECRET=replace-with-a-different-32-byte-secret
JYSEC_METRICS_TOKEN=replace-with-a-third-32-byte-secret
JYSEC_RUNS_ROOT=/var/lib/jysec/runs
STRIX_BIN=strix
STRIX_LLM=
LLM_API_KEY=

# Existing workflow-core deployment used by the compatibility adapter.
CYBERSTRIKE_BASE_URL=http://cyberstrike:8080
CYBERSTRIKE_SERVICE_TOKEN=

# Optional Stripe billing. Keep all real keys outside source control.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_BUSINESS=
JYSEC_PUBLIC_BASE_URL=http://localhost:8787
JYSEC_INTERNAL_CALLBACK_BASE_URL=http://control-plane:8787
