NODE_ENV=development
JYSEC_HOST=0.0.0.0
JYSEC_PORT=8787
JYSEC_LOG_LEVEL=info

# Use PostgreSQL in production. memory is only for local evaluation and tests.
JYSEC_STORE=memory
DATABASE_URL=postgres://jysec:change-me@postgres:5432/jysec
REDIS_URL=redis://redis:6379/0

# A minimum 32-byte random secret. Do not commit its real value.
JYSEC_JWT_SECRET=replace-with-at-least-32-random-bytes
# Optional enterprise IdP. Leave empty to use HS256 with JYSEC_JWT_SECRET.
JYSEC_JWKS_URL=
JYSEC_JWT_ISSUER=jysecai
JYSEC_JWT_AUDIENCE=jysec-platform
JYSEC_DEV_AUTH=true

# Worker-to-control-plane job authenticity.
JYSEC_JOB_SIGNING_SECRET=replace-with-a-different-32-byte-secret
JYSEC_METRICS_TOKEN=replace-with-a-third-32-byte-secret
JYSEC_RUNS_ROOT=/var/lib/jysec/runs
# Development and test default to enabled when omitted; declare it so availability is visible.
JYSEC_ENGINE_STRIX_ENABLED=true
STRIX_BIN=strix
STRIX_LLM=
LLM_API_KEY=

# Existing workflow-core deployment used by the compatibility adapter.
CYBERSTRIKE_BASE_URL=http://cyberstrike:8080
CYBERSTRIKE_SERVICE_TOKEN=

# Uniform HTTP adapters remain unavailable until their service URL is configured.
JYSEC_ENGINE_HEXSTRIKE_URL=
JYSEC_ENGINE_KALI_MCP_URL=
JYSEC_ENGINE_AWVS_URL=
JYSEC_ENGINE_PROMPTFOO_URL=
JYSEC_ENGINE_PYRIT_URL=
JYSEC_ENGINE_GISKARD_URL=
JYSEC_ENGINE_ART_URL=
JYSEC_ENGINE_HUMANBOUND_URL=
JYSEC_ENGINE_AD_AUDIT_URL=
JYSEC_ENGINE_ADAPTER_TOKEN=

# Scanner adapter. Keep backend APIs private; only this adapter needs access.
# Default binds 127.0.0.1 (loopback only). The compose stack overrides this to
# 0.0.0.0 so the gateway container can reach the adapter — leave it private when
# running outside Docker. The adapter fails closed without an adapter token above.
JYSEC_SCANNER_ADAPTER_HOST=127.0.0.1
JYSEC_SCANNER_ADAPTER_PORT=8790
JYSEC_HEXSTRIKE_API_URL=http://host.docker.internal:8888
JYSEC_KALI_API_URL=http://host.docker.internal:5000
JYSEC_AWVS_API_URL=https://awvs.example.internal:3443
JYSEC_AWVS_API_KEY=
JYSEC_AWVS_CA_FILE=
# Optional TLS DNS name for appliance certificates that encode an IP as a DNS SAN.
JYSEC_AWVS_TLS_SERVER_NAME=
JYSEC_SCANNER_MAX_CONCURRENT_PER_ENGINE=2
JYSEC_SCANNER_REQUEST_TIMEOUT_SECONDS=300
JYSEC_SCANNER_MAX_RETRIES=3
JYSEC_AWVS_POLL_INTERVAL_SECONDS=15
JYSEC_PROXY_POOL=vps-221|socks5h://127.0.0.1:11080|http://127.0.0.1:12080|202.160.76.221;vps-173|socks5h://127.0.0.1:11081|http://127.0.0.1:12081|202.160.76.173;vps-169|socks5h://127.0.0.1:11082|http://127.0.0.1:12082|202.160.76.169;vps-168|socks5h://127.0.0.1:11083|http://127.0.0.1:12083|202.160.76.168;vps-167|socks5h://127.0.0.1:11084|http://127.0.0.1:12084|202.160.76.167

# Optional Stripe billing. Keep all real keys outside source control.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_BUSINESS=
JYSEC_PUBLIC_BASE_URL=http://localhost:8787
JYSEC_INTERNAL_CALLBACK_BASE_URL=http://control-plane:8787
