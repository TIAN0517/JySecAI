{
  "name": "@jy-technical-team/jysec-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "JySecAI commercial control plane and governed security-engine runtime",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch --import tsx src/main.ts",
    "dev:worker": "node --env-file-if-exists=.env --watch --import tsx src/worker/main.ts",
    "dev:scanner-adapter": "node --env-file-if-exists=.env --watch --import tsx src/scanner-adapter/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "start:worker": "node --env-file-if-exists=.env dist/worker/main.js",
    "start:scanner-adapter": "node --env-file-if-exists=.env dist/scanner-adapter/main.js",
    "test": "vitest run --coverage.enabled=false",
    "test:watch": "vitest",
    "check": "tsc -p tsconfig.json --noEmit && vitest run --coverage.enabled=false"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.3",
    "@prometheus-io/client": "^0.16.1",
    "fastify": "^5.6.0",
    "fastify-raw-body": "^6.0.1",
    "ioredis": "^5.7.0",
    "ipaddr.js": "^2.2.0",
    "jose": "^6.1.0",
    "pg": "^8.16.3",
    "stripe": "^18.5.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
