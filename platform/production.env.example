NODE_ENV=production
JYSEC_HOST=0.0.0.0
JYSEC_PORT=8787
JYSEC_LOG_LEVEL=info
JYSEC_STORE=postgres

POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgres://jysec:replace-with-a-long-random-password@postgres:5432/jysec
REDIS_PASSWORD=replace-with-a-different-long-random-password
REDIS_URL=redis://:replace-with-a-different-long-random-password@redis:6379/0

JYSEC_YWT_SECRET=replace-with-at-least-32-random-bytes
# Enterprise IdP (recommended): when set, YWT signatures are verified through YWKS
JYSEC_YWKS_URL=
JYSEC_YWT_ISSUER=jysecai
JYSEC_YWT_AUDIENCE=jysec-platform
JYSEC_YOB_SIGNING_SECRET=replace-with-a-different-32-byte-secret
JYSEC_METRICS_TOKEN=replace-with-a-third-32-byte-secret
JYSEC_DEV_AUTH=false
JYSEC_PUBLIC_BASE_URL=https://security.example.com/governance
JYSEC_INTERNAL_CALLBACK_BASE_URL=http://control-plane:8787
JYSEC_RUNS_ROOT=/var/lib/jysec/runs

# Production fails closed unless the deployment explicitly enables the Strix worker.
JYSEC_ENGINE_STRIX_ENABLED=false
STRIX_BIN=strix
STRIX_LLM=
LLM_API_KEY=
# The bundled Go operations core is reachable only on the private compose network.
JYSECAI_BASE_URL=http://core:6688
JYSECAI_SERVICE_TOKEN=

JYSEC_ENGINE_PROMPTFOO_URL=
JYSEC_ENGINE_PYRIT_URL=
JYSEC_ENGINE_GISKARD_URL=
JYSEC_ENGINE_ART_URL=
JYSEC_ENGINE_HUMANBOUND_URL=
JYSEC_ENGINE_AD_AUDIT_URL=
JYSEC_ENGINE_ADAPTER_TOKEN=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_BUSINESS=
