  "components": {
    "schemas": {
      "CreditCardModel": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "Id": {
            "type": "integer",
            "description": "信用卡ID",
            "format": "int32"
          },
          "CardNoMask": {
            "type": "string",
            "description": "信用卡號",
            "nullable": true
          },
          "BankDesc": {
            "type": "string",
            "description": "發卡銀行",
            "nullable": true
          },
          "MemberOneID": {
            "type": "string",
            "description": "會員OneID",
            "nullable": true
          },
          "IsAvailable": {
            "type": "boolean",
            "description": "是否有效 1:有效 0:無效"
          },
          "IsOverwrite": {
            "type": "boolean",
            "description": "因重複綁卡失效 1:重複失效 0:有效"
          },
          "IsExpired": {
            "type": "boolean",
            "description": "是否失效 1:失效 0:有效"
          },
          "CardType": {
            "type": "string",
            "description": "發卡機構",
            "nullable": true
          },
          "AffinityCode": {
            "type": "string",
            "description": "聯名卡認同代碼",
            "nullable": true
          },
          "AliasName": {
