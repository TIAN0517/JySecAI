multi_agent:
  enabled: true
  robot_default_agent_mode: eino_single
  batch_use_multi_agent: false
  plan_execute_loop_max_iterations: 0
  sub_agent_user_context_max_runes: 0
  without_general_sub_agent: false
  without_write_todos: false
  orchestrator_instruction: ''
  orchestrator_instruction_plan_execute: ''
  orchestrator_instruction_supervisor: ''
  eino_skills:
    disable: false
    filesystem_tools: true
    skill_tool_name: skill
  eino_middleware:
    patch_tool_calls: true
    tool_search_enable: true
    tool_search_min_tools: 20
    tool_search_always_visible: 12
    tool_search_always_visible_tools: [read_file, glob, grep, analyze_image, write_file, edit_file, execute, task, transfer_to_agent, exit, write_todos, skill, tool_search, TaskCreate, TaskGet, TaskUpdate, TaskList, record_vulnerability, list_vulnerabilities, get_vulnerability, get_tool_execution, wait_tool_execution, cancel_tool_execution, list_knowledge_risk_types, search_knowledge_base, webshell_exec, webshell_file_list, webshell_file_read, webshell_file_write, manage_webshell_list, manage_webshell_add, manage_webshell_update, manage_webshell_delete, manage_webshell_test, batch_task_list, batch_task_get, batch_task_start, batch_task_rerun, batch_task_pause, batch_task_update_metadata, batch_task_update_schedule, batch_task_schedule_enabled, batch_task_update_task, batch_task_remove_task, batch_task_delete, batch_task_create, batch_task_add_task, http-framework-test, exec, bloodhound, binwalk]
    plantask_enable: true
    plantask_rel_dir: .eino/plantask
    reduction_enable: true
    reduction_max_length_for_trunc: 100000
    reduction_max_tokens_for_clear: 60000
    reduction_root_dir: ''
    reduction_clear_exclude: []
    reduction_sub_agents: true
    summarization_trigger_ratio: 0.8
    summarization_output_reserve_tokens: 8192
    summarization_emit_internal_events: true
    summarization_user_intent_ledger_max_runes: 96000
    summarization_user_intent_ledger_entry_max_runes: 16000
    latest_user_message_max_runes: 48000
    latest_user_message_head_runes: 24000
    latest_user_message_tail_runes: 24000
    plan_execute_user_input_budget_ratio: 0.35
    plan_execute_executed_steps_budget_ratio: 0.2
    plan_execute_max_step_result_runes: 4000
    plan_execute_keep_last_steps: 8
    checkpoint_dir: ''
    model_retry_max_retries: 6
    model_retry_max_backoff_sec: 45
    model_failover_channels: [jy-gateway]
    model_failover_max_retries: 2
    empty_response_continue_max_attempts: 0
    deep_output_key: final_answer
    task_tool_description_prefix: ''
  eino_callbacks:
    enabled: true
    mode: log_only
    sse_trace_to_client: false
    max_input_summary_runes: 400
    max_output_summary_runes: 400
    zap_verbose: false
    otel:
      enabled: true
      service_name: jysecai
      exporter: stdout
      otlp_endpoint: localhost:4318
      sample_ratio: 1.0
database:
  path: data/conversations.db
  knowledge_db_path: data/knowledge.db
security:
  tools_dir: tools
  tool_description_mode: full
mcp:
  enabled: true
  host: 127.0.0.1
  port: 6689
  auth_header: "X-MCP-Token"
  auth_header_value: "5918858678fcd197997116dfbe7a81458639a35056bfa4d27c6fbdda7460bc63"
  allow_global_access: true
external_mcp:
  servers:
    pent-claude-agent:
      command: C:/Program Files/Python311/python.exe
      args:
        - mcp-servers/pent_claude_agent/mcp_pent_claude_agent.py
      description: Pentest execution agent bridge.
      timeout: 120
      disabled: false
      max_retries: 3
      keep_alive: 15
      external_mcp_enable: true
      tool_enabled:
        pent_agent_diagnose: true
        pent_agent_execute: true
        pent_claude_analyze_vulnerability: true
        pent_claude_run_pentest_task: true
        pent_claude_status: true
    bloodhound:
      command: uv
      args:
        - --directory
        - /opt/bloodhound-mcp
        - run
        - main.py
      env:
        BLOODHOUND_TOKEN_KEY: ""
        BLOODHOUND_DOMAIN: bloodhound.example.test
        BLOODHOUND_SCHEME: http
        BLOODHOUND_PORT: "8080"
        BLOODHOUND_TOKEN_ID: ""
      description: BloodHound CE graph queries (AD/Entra attack-path). Requires self-deployed bloodhound-mcp.
      timeout: 30
      disabled: true
      max_retries: 3
      keep_alive: 15
      external_mcp_enable: false
    dragon-v:
      command: C:/Program Files/Python311/python.exe
      args:
        - mcp-servers/dragon_v/dragon_v_mcp_server.py
      description: 'Dragon-V: offline CVE, fingerprints, payloads and authorized pentest chain.'
      timeout: 180
      disabled: false
      max_retries: 5
      keep_alive: 30
      external_mcp_enable: true
      tool_enabled:
        dragonv_vulnerability_scan: true
        dragonv_health: true
        dragonv_lookup_fingerprint: true
        dragonv_port_scan: true
        dragonv_get_exploit_details: true
        dragonv_stats: true
        dragonv_search_payloads: true
        dragonv_search_exploits: true
        dragonv_generate_payload: true
        dragonv_hunter_scan: true
    reverse-shell:
      command: C:/Program Files/Python311/python.exe
      args:
        - mcp-servers/reverse_shell/mcp_reverse_shell.py
      description: 'Reverse shell: start/stop TCP listener, run commands on connected target.'
      timeout: 60
      disabled: false
      max_retries: 3
      keep_alive: 15
      external_mcp_enable: true
      tool_enabled:
        reverse_shell_status: true
        reverse_shell_stop_listener: true
        reverse_shell_disconnect: true
        reverse_shell_send_command: true
        reverse_shell_start_listener: true
    vuln-intel:
      command: C:/Program Files/Python311/python.exe
      args:
        - mcp-servers/vuln_intel/mcp_vuln_intel.py
      description: 'Vulnerability intelligence: CVE/KEV/EPSS lookup.'
      timeout: 60
      disabled: false
      max_retries: 3
      keep_alive: 15
      external_mcp_enable: true
      tool_enabled:
        vuln_search_cves: true
        vuln_search_public_pocs: true
        vuln_triage_cve: true
        vuln_emerging_threat_watch: true
        vuln_get_advisory: true
        vuln_intel_source_health: true
        vuln_query_package: true
    redteam-knowledge:
      command: C:/Program Files/Python311/python.exe
      args:
        - mcp-servers/redteam_knowledge/mcp_redteam_knowledge.py
      description: 'Redteam knowledge: ATT&CK techniques, playbooks, and bypass references.'
      timeout: 60
      disabled: false
      max_retries: 3
      keep_alive: 15
      external_mcp_enable: true
      tool_enabled:
        redteam_get_atomic_tests: true
        redteam_get_attack: true
        redteam_knowledge_health: true
        redteam_search_attack: true
        redteam_search_gtfobins: true
        redteam_search_lolbas: true
